# Variable names only; configure values outside this export.
ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to <first ALLOWED_ORIGINS entry>/api/auth/google/callback
GOOGLE_REDIRECT_URI=
DATABASE_URL=
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
NODE_ENV=
NOMINATIM_USER_AGENT=
PRIVATE_OBJECT_DIR=
RAZORPAY_MODE=
RESEND_FROM=
RESEND_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
# App Platform: paste the service-account JSON (or base64) instead of a file path
GOOGLE_APPLICATION_CREDENTIALS_JSON=
LOG_LEVEL=
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
PORT=
# Optional performance tuning (defaults shown in docs/performance.md)
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=
DB_POOL_RECYCLE=
DB_CONNECT_TIMEOUT=
SLOW_REQUEST_MS=
