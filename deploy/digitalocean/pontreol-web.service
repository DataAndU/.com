[Unit]
Description=Pontreol web (Next.js)
After=network-online.target pontreol-api.service
Wants=network-online.target

[Service]
User=pontreol
WorkingDirectory=/opt/pontreol/artifacts/pontreol
EnvironmentFile=/etc/pontreol/pontreol.env
# Binds 0.0.0.0 because Next/Clerk middleware rewrites proxy back through
# localhost:3000 (fails when bound to 127.0.0.1). ufw keeps 3000 private.
ExecStart=/usr/bin/env pnpm exec next start --hostname 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
