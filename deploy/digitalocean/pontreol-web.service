[Unit]
Description=Pontreol web (Next.js)
After=network-online.target pontreol-api.service
Wants=network-online.target

[Service]
User=pontreol
WorkingDirectory=/opt/pontreol/artifacts/pontreol
EnvironmentFile=/etc/pontreol/pontreol.env
# ufw keeps port 3000 private; only nginx is public.
ExecStart=/usr/bin/env pnpm exec next start --hostname 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
