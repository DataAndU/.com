# /etc/pontreol/pontreol.env  (chown root:pontreol, chmod 640). Never commit real values.
NODE_ENV=production

# Canonical public origin. Drives trusted hosts, CORS, CSRF origin checks and Clerk azp.
ALLOWED_ORIGINS=https://pontreol.com

# PostgreSQL on localhost/private network only. Use sslmode=require for managed DBs.
DATABASE_URL=postgresql://pontreol:CHANGE_ME@127.0.0.1:5432/pontreol
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10

# Clerk (production instance). The publishable key is also exposed to the browser.
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME
# Optional Clerk frontend-API proxy (must also be enabled in the Clerk dashboard):
CLERK_PROXY_URL=/api/__clerk
NEXT_PUBLIC_CLERK_PROXY_URL=/api/__clerk
# Optional overrides; derived from the publishable key when empty:
CLERK_ISSUER_URL=
CLERK_JWKS_URL=

# Razorpay. Mode selects which credential set is used; keep test and live separate.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_TEST_KEY_SECRET=CHANGE_ME
RAZORPAY_TEST_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Google Cloud Storage (listing photos + private ID images).
# Service-account JSON key (roles/storage.objectAdmin on the bucket); signing
# upload/download URLs requires a key-bearing service account.
GOOGLE_APPLICATION_CREDENTIALS=/etc/pontreol/gcs-service-account.json
DEFAULT_OBJECT_STORAGE_BUCKET_ID=pontreol-media
PRIVATE_OBJECT_DIR=private

# Resend (notification email). Absent => emails stay queued, app keeps working.
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM=Pontreol <notifications@pontreol.com>

NOMINATIM_USER_AGENT=Pontreol/1.0 (https://pontreol.com; ops@pontreol.com)
LOG_LEVEL=INFO
SLOW_REQUEST_MS=500
