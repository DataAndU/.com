{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development uv run --project ../.. uvicorn app:app --app-dir python --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "uv run --project ../.. python -m compileall -q python",
    "start": "uv run --project ../.. uvicorn app:app --app-dir python --host 0.0.0.0 --port ${PORT:-8080} --no-access-log --timeout-keep-alive 30",
    "migrate:dev": "NODE_ENV=development uv run --project ../.. python python/migrate_dev.py",
    "grant-admin": "uv run --project ../.. python python/grant_admin.py",
    "notifications:send": "uv run --project ../.. python python/outbox.py",
    "test": "NODE_ENV=test uv run --project ../.. pytest python/tests"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
